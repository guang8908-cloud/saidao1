# 复制为 .env.local，再填写你选用的模型。密钥仅供服务端使用。
# 推荐的云端示例：DeepSeek 官方 API。按量计费，价格以官方控制台为准。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_MAX_TOKENS=2048
LLM_THINKING=disabled

# 其他云端兼容接口：替换上面的地址、模型名称、密钥。
# 例如硅基流动：https://api.siliconflow.cn/v1；不支持 thinking 的模型请把 LLM_THINKING 留空。
# 模型名称与当前费用以服务商控制台为准。
# 本地 Ollama：http://127.0.0.1:11434/v1；填写已下载模型名，密钥和 LLM_THINKING 留空。

# 可选：高德 Web JS 地图。留空时页面显示地图暂不可用，不影响聊天。
# NEXT_PUBLIC_ 配置会进入浏览器，需在高德控制台限制允许使用的域名。
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
